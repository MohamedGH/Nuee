datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  category    String
  description String
  priceCents  Int
  lookNumber  Int
  image       String
  images      String? // URLs additionnelles séparées par des virgules, pour la galerie
  colors      String
  createdAt   DateTime  @default(now())
  variants    Variant[]
  orderItems  OrderItem[]
  reviews     Review[]
  stockAlerts StockAlert[]
}

model Variant {
  id        String  @id @default(cuid())
  size      String
  stock     Int     @default(20)
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@unique([productId, size])
}

model Order {
  id              String      @id @default(cuid())
  stripeSessionId String      @unique
  customerEmail   String
  status          String      @default("pending")
  totalCents      Int
  discountCents   Int         @default(0)
  couponCode      String?
  shippingMethod  String      @default("standard")
  shippingCents   Int         @default(0)
  giftWrap        Boolean     @default(false)
  shippingName    String?
  shippingLine1   String?
  shippingLine2   String?
  shippingCity    String?
  shippingPostal  String?
  shippingCountry String?
  gaClientId      String? // client_id GA4 côté navigateur, pour l'event purchase envoyé depuis le webhook
  gaPurchaseSent  Boolean     @default(false)
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id])
  orderId    String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  size       String
  quantity   Int
  priceCents Int
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  percentOff  Int? // 1-100
  amountOff   Int? // en centimes, alternative à percentOff
  maxUses     Int? // null = illimité
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  authorName String
  rating     Int // 1-5
  comment    String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model StockAlert {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  size      String
  email     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, size, email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
