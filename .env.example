DATABASE_URL="file:./dev.db"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Espace admin (/admin) — génère le hash avec: npm run admin:hash -- "ton-mot-de-passe"
# La commande échappe déjà les $ (obligatoire : @next/env corrompt sinon
# silencieusement un hash bcrypt collé tel quel). Colle sa sortie sans y toucher.
ADMIN_PASSWORD_HASH="$2a$12$..."
ADMIN_SESSION_SECRET="une-chaine-aleatoire-d-au-moins-32-caracteres"

# Analytique (optionnel — sans ces variables, aucun script de suivi n'est chargé)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_CLARITY_ID="votre-id-clarity"
NEXT_PUBLIC_ENABLE_TOPICS="false"
# Généré dans GA4 → Admin → Flux de données → Measurement Protocol API
# secrets. Serveur uniquement (jamais NEXT_PUBLIC_) — sert à l'event
# purchase envoyé depuis le webhook, indépendant du script côté navigateur.
GA4_API_SECRET="votre-api-secret-ga4"

# Réseaux sociaux (optionnel — affichés en pied de page uniquement si
# renseignés, absents sinon)
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_PINTEREST_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
